{
    "name": "chili3d",
    "version": "0.7.1",
    "description": "",
    "documentVersion": "0.7.1",
    "author": "仙阁",
    "type": "module",
    "scripts": {
        "build": "node scripts/external-assets.mjs --check && next build packages/web --webpack && node scripts/collect-web-export.mjs && node scripts/build-plugins.mjs && node scripts/external-assets.mjs --check-dist",
        "build:offline": "node scripts/offline.mjs npm run build",
        "assets:check": "node scripts/external-assets.mjs --check",
        "assets:refresh": "node scripts/external-assets.mjs --refresh",
        "offline:prepare": "node scripts/prepare-offline.mjs",
        "offline:prepare:rust": "node scripts/cache-rust.mjs",
        "offline:verify": "node scripts/prepare-offline.mjs --verify",
        "preview:offline": "node scripts/serve-offline.mjs",
        "build:wasm": "cd cpp && cmake --preset release && cmake --build --preset release && node ../scripts/wasm-provenance.mjs",
        "check:wasm": "node scripts/wasm-provenance.mjs --verify",
        "audit:onshape": "node scripts/audit-onshape-tools.mjs",
        "test:onshape": "rstest packages/parametric/test/featurescript/onshapeConformance.kernel.test.ts packages/parametric/test/featurescript/onshapeConformance.test.ts packages/parametric/test/featurescript/standardFeatures.kernel.test.ts",
        "compare:onshape": "node scripts/onshape-conformance.mjs compare",
        "build:types": "node scripts/generate_types.mjs",
        "check": "biome check --write",
        "check:ci": "biome check --diagnostic-level=error",
        "typecheck": "node scripts/typecheck.mjs",
        "typecheck:rust": "node scripts/typecheck.mjs --compiler rust",
        "typecheck:go": "node scripts/typecheck.mjs --compiler go",
        "typecheck:legacy": "node scripts/typecheck.mjs --compiler legacy",
        "typecheck:offline": "node scripts/offline.mjs node scripts/typecheck.mjs",
        "dev": "next dev packages/web --webpack --port 8080",
        "format": "biome check --write . && npx clang-format --style=Webkit --sort-includes -i ./cpp/src/**",
        "generate:capabilities": "node scripts/generate-shape-capabilities.mjs",
        "preview": "node scripts/serve-offline.mjs",
        "release": "node scripts/release.mjs",
        "setup:wasm": "node scripts/setup_wasm_deps.mjs",
        "build:rust": "node scripts/build-rust.mjs",
        "setup:rust": "rustup target add wasm32-unknown-unknown && cargo install wasm-bindgen-cli --version 0.2.129 --locked",
        "test:rust": "cargo test --manifest-path rust/Cargo.toml",
        "test:rust:offline": "node scripts/offline.mjs cargo --config .offline/rust-config.toml test --locked --manifest-path rust/Cargo.toml",
        "test": "rstest",
        "test:offline": "node scripts/external-assets.mjs --check && node scripts/offline.mjs npm test",
        "test:onshape:offline": "node scripts/offline.mjs npm run test:onshape",
        "testc": "rstest --coverage"
    },
    "simple-git-hooks": {
        "pre-commit": "npx lint-staged"
    },
    "lint-staged": {
        "*.{ts,js,css,json,mjs}": [
            "npx biome check --write"
        ],
        "*.{c,h,cxx,hxx,cpp,hpp}": [
            "npx clang-format --style=Webkit --sort-includes -i"
        ]
    },
    "workspaces": [
        "packages/*",
        "plugins/*"
    ],
    "devDependencies": {
        "@biomejs/biome": "^2.4.15",
        "@rspack/cli": "^2.0.3",
        "@rspack/core": "^2.0.3",
        "@rstest/core": "^0.10.0",
        "@rstest/coverage-istanbul": "^0.10.0",
        "clang-format": "^1.8.0",
        "fake-indexeddb": "^6.2.5",
        "happy-dom": "^20.9.0",
        "lint-staged": "^17.0.5",
        "simple-git-hooks": "2.13.1",
        "tsc-rs": "0.1.0",
        "typescript": "^6.0.3",
        "typescript-go": "npm:typescript@7.1.0-dev.20260929.1",
        "typescript-plugin-css-modules": "^5.2.0"
    },
    "dependencies": {
        "@types/jszip": "^3.4.0",
        "jszip": "^3.10.1"
    }
}
